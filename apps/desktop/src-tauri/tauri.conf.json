{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ordine",
  "version": "0.0.1",
  "identifier": "ai.ordine.desktop",
  "build": {
    "beforeDevCommand": "cd ../app && bun run dev -- --port 9431",
    "devUrl": "http://localhost:9431",
    "beforeBuildCommand": "cd ../app && bun run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ordine",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
