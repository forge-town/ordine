VITE_APP_URL=http://localhost:9430
VITE_MASTRA_API_URL=http://localhost:4111
ORDINE_API_PROXY_TARGET=http://localhost:9433
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ordine

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Configuration (OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

BETTER_AUTH_SECRET=change-me-to-random-hex-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RUNTIME_SCAN_MODE=local
# Optional comma-separated executable overrides for supported runtime names.
# Useful when a CLI is installed outside the server process PATH.
# ORDINE_EXTRA_RUNTIMES=hermes:C:/path/to/hermes.exe
# HERMES_BIN=C:/path/to/hermes.exe

# ⚠️ Local Mode — for self-hosted single-machine use ONLY.
# When enabled, a default local user is auto-created and logged in on first visit.
# Do NOT enable in shared / production environments.
ORDINE_LOCAL_MODE=false
