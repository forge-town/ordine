{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "ORDINE_CREATE_TEST_DATABASE_URL",
    "ORDINE_DB_SCHEMA_TEST_DATABASE_URL",
    "ORDINE_MODELS_TEST_DATABASE_URL",
    "PLAYWRIGHT_DATABASE_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".vitepress/dist/**",
        ".output/**",
        "app/**"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "quality": {
      "dependsOn": ["^quality"]
    },
    "dev": {
      "cache": false,
      "env": ["HERMES_BIN", "ORDINE_EXTRA_RUNTIMES", "ORDINE_LOCAL_MODE", "RUNTIME_SCAN_MODE"],
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    }
  }
}
